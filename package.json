{
  "name": "jarvis",
  "private": true,
  "version": "1.0.0",
  "description": "J.A.R.V.I.S. — Iron Man Holographic Assistant",
  "author": "Josh <josh@jarvis.local>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:writes": "JARVIS_ALLOW_WRITES=1 node bridge/server.mjs",
    "setup": "node scripts/setup.mjs",
    "sync": "node scripts/brain-sync.mjs",
    "sync:push": "node scripts/brain-sync.mjs --push",
    "proactive": "node scripts/proactive.mjs --toast",
    "tasks:install": "powershell -ExecutionPolicy Bypass -File scripts/install-tasks.ps1",
    "desktop": "electron electron/main.cjs",
    "desktop:dev": "npm run build && electron electron/main.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.116.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "thinking-orbs": "^0.3.2",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.jarvis.app",
    "productName": "J.A.R.V.I.S.",
    "artifactName": "JARVIS-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026 J.A.R.V.I.S.",
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS",
      "menuCategory": false
    },
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "files": [
      "dist/**",
      "bridge/**",
      "brain-proxy.mjs",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      "public/**"
    ],
    "asar": true,
    "asarUnpack": [
      "bridge/**",
      "brain-proxy.mjs",
      "node_modules/ws/**",
      "node_modules/zod/**",
      "node_modules/@anthropic-ai/**"
    ]
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.1": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.5": true,
    "sharp@0.34.5": true
  }
}
