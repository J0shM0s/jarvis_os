# Copy this file to: openrouter.env  (same folder)
# Then paste YOUR values from https://openrouter.ai/keys
# NEVER commit openrouter.env to git. It is your account's key.
OPENROUTER_API_KEY=paste-your-openrouter-key
# Any OpenRouter model id, e.g. nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Local port for the brain proxy. Default 8790.
BRAIN_PROXY_PORT=8790

# Brain priority chain — the order IS the priority. Default:
#   BRAIN_PRIORITY=openrouter,ollama
# When the first brain runs dry (OpenRouter's free daily cap answers 429 with
# a reset time), the proxy cools it down until then and every following turn
# automatically goes to the next brain in the chain. The local Ollama is the
# perfect P2: free, offline, always there. Reverse the order to make Ollama
# primary and OpenRouter the overflow brain. Remove a name to drop it.
BRAIN_PRIORITY=openrouter,ollama
# Where Ollama lives (default) and which of its models to use. Leave
# OLLAMA_MODEL empty to auto-pick the first tool-capable installed model —
# agents need tools, so a tool-capable model is strongly preferred.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional but recommended: shared secret the brain proxy requires from
# callers of /messages, so other local processes cannot spend your key.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The launcher passes it to the CLI automatically (ANTHROPIC_CUSTOM_HEADERS).
# BRAIN_PROXY_SECRET=
