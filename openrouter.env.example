# Copy this file to: openrouter.env  (same folder)
# Then paste YOUR values from https://openrouter.ai/keys
# NEVER commit openrouter.env to git. It is your account's key.
OPENROUTER_API_KEY=paste-your-openrouter-key
# Any OpenRouter model id, e.g. nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Local port for the brain proxy. Default 8790.
BRAIN_PROXY_PORT=8790

# Optional but recommended: shared secret the brain proxy requires from
# callers of /messages, so other local processes cannot spend your key.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The launcher passes it to the CLI automatically (ANTHROPIC_CUSTOM_HEADERS).
# BRAIN_PROXY_SECRET=
